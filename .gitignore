/node_modules
/.trae

# dev 日志（提交时排除）
/dsh-vite-dev.log
/dsh-web.log
/dsh-web.err.log
/dsh-web.log.err
/.workbuddy

# vite dev 临时文件与探针目录
/vite.config.ts.timestamp-*
/.cp-probe
/dist
/tmp

# 工作流产生的临时诊断/消息文件
/_*.txt
/_*.log
/_*.out
# Windows 保留名垃圾文件（会导致 git add -A 报 invalid path）
/nul
tmp
/readme

# 插件打包产物（由 plugins/pack.mjs 生成，勿提交）
/plugins/lib
/.qoder

# lib/web 旧 hash 资源：构建用只写不删拷贝（受限环境禁批量删除），历史产物会不断堆积；
# 当前入口引用名写在 lib/client.js 里随包发布，其余均可由 npm run build 再生。
# ⚠️ 实测本 git 版本下 `assets/xxx`（目录前缀、非锚定）不生效，必须写全相对路径。
lib/web/assets/index-*.js
lib/web/assets/vendor-*.js
lib/web/assets/style-*.css
!lib/web/assets/index-CJppKl6W.js
!lib/web/assets/vendor-C2cID70-.js
!lib/web/assets/vendor-vue-DSVMyY-k.js
!lib/web/assets/vendor-element-plus-CPaGIovE.js
!lib/web/assets/style-COzch9aT.css
# vite dev 中间产物（无扩展名探针目录）与历史测试 chunk：均非发布内容。
lib/web/assets/__dsh-test-probe
lib/web/assets/contribution-points.test-*.js
# 按需加载的杂散 chunk（构建只写不删，历史堆积可由 npm run build 再生）。
lib/web/assets/ConfirmDialog-*.js
# ⚠️ 当前入口闭包必须显式放行。注意：`index-*.js`/`style-*.css` 前缀规则会连带排除
# **新**入口文件（! 白名单只救旧名），换入口后必须把新 hash 名加进来；vendor-* 若重新拆出同理。
!lib/web/assets/index-D0CqeY8q.js
!lib/web/assets/style-DpdXIKsW.css
# AGENTS.md 的包内副本：build 每次从仓库根拷贝注入 lib/，无需入库。
/lib/AGENTS.md
