{
  "name": "@sunjuntao/dsh-file-workbench",
  "version": "0.2.1",
  "description": "DSH web plugin: a Vue 3 + Vite complete file workbench (explorer tree / code editor / markdown+image+html preview / file search / CRUD)",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "dsh",
    "plugin",
    "file",
    "explorer",
    "editor",
    "workbench",
    "dsh-plugin"
  ],
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-modules"
      ]
    }
  },
  "scripts": {
    "dev:vue": "vite",
    "build:vue": "vite build",
    "typecheck": "vue-tsc --noEmit",
    "build": "node scripts/build.mjs",
    "build:dev": "node scripts/build.mjs --dev",
    "sync": "node scripts/sync-to-profile.mjs",
    "deploy": "node scripts/build.mjs --dev && node scripts/sync-to-profile.mjs",
    "prepublishOnly": "node scripts/build.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1-rc.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.8",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": false
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    },
    "react": {
      "optional": false
    },
    "react-dom": {
      "optional": true
    },
    "vue": {
      "optional": false
    }
  },
  "devDependencies": {
    "@types/katex": "^0.16.7",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^5.4.0",
    "vue-tsc": "^2.1.0"
  },
  "dependencies": {
    "@file-viewer/doc": "^3.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "diff": "^9.0.0",
    "dockview-vue": "^8.2.0",
    "dompurify": "^3.2.0",
    "element-plus": "^2.14.5",
    "fflate": "^0.8.3",
    "fzstd": "^0.1.1",
    "highlight.js": "^11.12.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "katex": "^0.16.11",
    "mammoth": "^1.12.2",
    "marked": "^14.1.0",
    "mermaid": "^11.4.0",
    "node-pty": "^1.1.0",
    "vanilla-jsoneditor": "^3.13.0",
    "vue": "^3.5.0",
    "xlsx": "^0.18.5"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
